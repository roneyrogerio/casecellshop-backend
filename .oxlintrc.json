{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "unicorn",
    "vitest",
    "import",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "dist/"
  ],
  "rules": {
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/unbound-method": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-array-constructor": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect*"
        ]
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error",
    "typescript/prefer-readonly": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/return-await": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-at": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs"
      ],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/no-array-delete": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-for-in-array": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-unary-minus": "off",
        "typescript/only-throw-error": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/require-await": "off",
        "typescript/restrict-plus-operands": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/unbound-method": "off",
        "typescript/no-misused-spread": "off",
        "typescript/no-unsafe-enum-assignment": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/no-meaningless-void-operator": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "typescript/no-deprecated": "off",
        "typescript/prefer-readonly": "off",
        "typescript/return-await": "off"
      }
    },
    {
      "files": [
        "**/migrations/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "src/db/types/*.ts"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off",
        "typescript/no-empty-object-type": "off"
      }
    },
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 50,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "complexity": [
          "error",
          {
            "max": 10,
            "variant": "modified"
          }
        ],
        "max-depth": [
          "error",
          {
            "max": 4
          }
        ],
        "max-params": [
          "error",
          {
            "max": 4
          }
        ],
        "import/no-cycle": "error",
        "node/no-process-env": "error"
      }
    },
    {
      "files": [
        "src/shared/config.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "src/shared/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "src/shared/ não importa outras pastas de src/ (AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/contract/**/*.ts",
        "src/db/**/*.ts",
        "src/erp/**/*.ts",
        "src/http/**/*.ts",
        "src/queue/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(checkout|orders|health|billing|catalog|main)/|(^|/)app\\.ts$",
                "message": "A fronteira e o contrato não importam pastas de negócio, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/checkout/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(orders|health|billing|catalog|main)/|(^|/)app\\.ts$",
                "message": "Uma pasta de negócio não importa outra, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/orders/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(checkout|health|billing|catalog|main)/|(^|/)app\\.ts$",
                "message": "Uma pasta de negócio não importa outra, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/health/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(checkout|orders|billing|catalog|main)/|(^|/)app\\.ts$",
                "message": "Uma pasta de negócio não importa outra, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/billing/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(checkout|orders|health|catalog|main)/|(^|/)app\\.ts$",
                "message": "Uma pasta de negócio não importa outra, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/catalog/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(checkout|orders|health|billing|main)/|(^|/)app\\.ts$",
                "message": "Uma pasta de negócio não importa outra, src/app.ts nem src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/|^\\./sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "src/app.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)main/",
                "message": "src/app.ts não importa src/main/ (AD-025)."
              },
              {
                "regex": "(^|/)erp/sim/",
                "message": "Só src/main/ monta o ERP simulado; o resto do código usa a porta ErpClient (AD-004, AD-025)."
              }
            ]
          }
        ]
      }
    }
  ]
}
