{
  "name": "casecellshop-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "openapi": "node scripts/generate-openapi.ts",
    "lint:openapi": "redocly lint openapi.yaml",
    "check:specs": "node scripts/check-spec-limits.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "express": "5.3.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
