{
  "name": "casecellshop-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.12.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "openapi": "node scripts/generate-openapi.ts",
    "lint:openapi": "redocly lint openapi.yaml",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "test:changed": "vitest run --changed",
    "verify:fast": "npm run lint && npm run typecheck && npm run test:changed",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run openapi -- --check && npm run lint:openapi && npm run check:instructions && npm run check:migrations && npm run check:scripts && npm run check:unused && npm run check:duplication",
    "verify:full": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run openapi -- --check && npm run lint:openapi && npm run check:instructions && npm run check:migrations && npm run check:scripts && npm run check:unused && npm run check:duplication && npm run check:db-types",
    "check:instructions": "node scripts/check-instructions.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:unused": "knip --no-progress",
    "check:duplication": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones",
    "check:db-types": "node scripts/check-db-types.ts",
    "setup:local": "node scripts/setup-local.ts",
    "check:env": "node scripts/check-env.ts",
    "check:scripts": "node scripts/check-scripts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-sqs": "3.1161.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "express": "5.3.0",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@inquirer/input": "5.1.9",
    "@inquirer/select": "5.2.8",
    "@redocly/cli": "2.72.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "kysely-codegen": "0.20.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
